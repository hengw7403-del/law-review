# Loaded automatically from the project root; existing environment wins.
# Never commit the actual key.
DEEPSEEK_API_KEY=

# Direct API connection by default. Set true only when a working environment
# proxy or custom environment CA configuration is required.
DEEPSEEK_TRUST_ENV=false

# Optional: acceptance-only cap, counting every outgoing attempt including retries.
# LLM_TEST_CALL_LIMIT=20

# Optional: persistent HS256 signing secret (at least 32 bytes).
# If omitted, the app creates a random private work/jwt-secret.key.
# JWT_SECRET_KEY=
